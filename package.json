{
  "name": "farmers-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/server/db/seed.ts",
    "prepare": "husky",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:cf": "node tools/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@libsql/client": "0.18.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.3",
    "@vinext/cloudflare": "^1.3.0",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "pino": "10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "vinext": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "husky": "9.1.7",
    "jsdom": "29.0.1",
    "lint-staged": "17.4.1",
    "pino-pretty": "13.1.3",
    "playwright": "1.62.1",
    "postcss": "8.5.27",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0"
    ]
  }
}
