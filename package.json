{
  "name": "farmers-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/server/db/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@libsql/client": "0.18.0",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.38.4",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "dotenv": "18.0.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "jsdom": "30.1.0",
    "lint-staged": "17.5.1",
    "pino-pretty": "13.1.3",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0"
    ]
  }
}
